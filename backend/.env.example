# Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
RELOAD=True
DEVICE=cuda

# Model Selection (optional, defaults to best-quality versions)
SEGMENTATION_MODEL=rembg
DEPTH_MODEL=depth_anything_v2
RELIGHTING_MODEL=sdxl

# Performance Tuning
MAX_BATCH_SIZE=8
MAX_IMAGE_SIZE=4096

# Storage Paths (relative to project root)
MODELS_PATH=backend/models
ASSETS_PATH=assets
